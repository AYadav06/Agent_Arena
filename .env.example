# OpenRouter API Key for LLM reasoning (required)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Tavily API Key for web search tool (optional, needed if using search)
TAVILY_API_KEY=your_tavily_api_key_here

# Default model slug (can be overridden in UI or CLI)
MODEL=inclusionai/ling-3.0-flash-vl:free

# Agent execution limits
MAX_ITERATIONS=8
MAX_REPLANS=1
